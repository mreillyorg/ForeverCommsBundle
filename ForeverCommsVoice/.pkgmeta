package-as: ForeverCommsVoice

# Use the suite's curated changelog rather than a generated commit dump, and keep it out
# of the addon folder. The release workflow copies the repository-root CHANGELOG.md in
# here before packaging; run standalone without that copy and release.sh just warns and
# generates one instead. See the root .pkgmeta for why the ignore entry below is required
# rather than tidy.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - CHANGELOG.md
  - .github
  - install
  - tests
  - README.md
  - Media/ProjectIcon.png
